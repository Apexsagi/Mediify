# GEMINI_API_KEY: Required for server-side Gemini AI inference.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL / CUSTOM_DOMAIN_URL: Public application URL for OAuth callbacks, CORS, and email redirects.
APP_URL=
CUSTOM_DOMAIN_URL=

# SESSION_SECRET: Server-side HMAC signing secret for session tokens (32+ hex chars).
SESSION_SECRET=

# Supabase PostgreSQL & Auth (for production cloud deployment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth options (optional)
EMAIL_VERIFICATION_REQUIRED=false
GOOGLE_OAUTH_ENABLED=false

# LingSante-3.1-air-VL & External Medical LLM Inference (server-side only)
LINGSANTE_API_URL=
LINGSANTE_API_KEY=
HUGGINGFACE_API_TOKEN=
OPENAI_COMPATIBLE_API_URL=
OPENAI_COMPATIBLE_API_KEY=

# Healthcare Clearinghouse & EHR FHIR R4 Integration Credentials
CLEARINGHOUSE_API_URL=
CLEARINGHOUSE_CLIENT_ID=
CLEARINGHOUSE_CLIENT_SECRET=
EPIC_FHIR_CLIENT_ID=
CERNER_FHIR_CLIENT_ID=
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=

# Optional outbound webhook URL for demo/contact email dispatch notifications
LEAD_NOTIFICATION_WEBHOOK_URL=
